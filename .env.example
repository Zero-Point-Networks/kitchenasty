# Local Docker dev environment configuration.
# Copy to `.env` (auto-loaded by docker compose) and override as needed.
# A bare `docker compose up` works with these defaults without a .env file.

# PostgreSQL password (used by the postgres, migrate and server services).
POSTGRES_PASSWORD=kitchenasty

# JWT signing secret for the API. Change this for anything non-local.
JWT_SECRET=change-this-to-a-random-secret

# Public origin the storefront is served at. Dine-in QR codes are generated
# pointing here. For scanning from a phone, set this to the host's LAN origin
# (e.g. http://192.168.1.50:5174) instead of localhost.
PUBLIC_URL=http://localhost:5174
